<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC<
    "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.ProductRepository">
	
    <resultMap id="ProductResultMap" type="com.example.fullness.stationary.entity.Product">
        <id property="id" column="id" />
        <result property="productCategoryId" column="product_category_id" />
        <result property="name" column="name" />
        <result property="price" column="price" />
        <result property="imageUrl" column="image_url" />
        <result property="deleteFlag" column="delete_flg" />
        <result property="categoryName" column="category_name" />
    </resultMap>

    <select id="findByCategoryWithPaging" resultMap="ProductResultMap">
        SELECT
            p.id,
            p.product_category_id,
            p.name,
            p.price,
            p.image_url,
            p.delete_flg,
            pc.name as category_name
        FROM product p
        INNER JOIN product_category pc ON p.product_category_id = pc.id
        WHERE p.delete_flg = 0
        <if test="categoryId != null">
            AND p.product_category_id = #{categoryId}
        </if>
        ORDER BY p.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCategory" resultType="int">
        SELECT COUNT(*)
        FROM product p
        WHERE p.delete_flg = 0
        <if test="categoryId != null">
            AND p.product_category_id = #{categoryId}
        </if>
    </select>
    



    <!-- 全件取得 ああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああ -->
    

    <select id="countAll">
        SELCT COUNT(*) FROM products
    </select>

    <select id="findPage">
        SELECT * 
        FROM product
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset} 
    </select>
</mapper>