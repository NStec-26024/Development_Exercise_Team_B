

<mapper namespace="com.example.ec.repository.ProductCategoryMapper">

 <resultMap id="ProductCategoryResultMap" type="com.example.ec.entity.ProductCategory">
 <id property="id" column="id"/>
 <result property="name" column="name"/>
 </resultMap>

 <select id="findAll" resultMap="ProductCategoryResultMap">
 SELECT 
 id,
 name
 FROM product_category
 ORDER BY id ASC
 </select>

</mapper>