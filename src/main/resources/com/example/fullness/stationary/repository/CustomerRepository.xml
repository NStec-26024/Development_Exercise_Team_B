<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.fullness.stationary.repository.CustomerRepository">
    <select id="findByMailAddress" resultType="com.example.fullness.stationary.entity.Customer">
        SELECT <include refid="allColumns"/>
        FROM customer
        WHERE mail_address = #{mailAddress}
    </select>
</mapper>
